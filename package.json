{
  "name": "@glasshome/sync-layer",
  "version": "0.11.3",
  "description": "Type-safe, reactive state synchronization layer for Home Assistant",
  "keywords": [
    "home-assistant",
    "reactive",
    "smart-home",
    "solidjs",
    "typescript",
    "websocket"
  ],
  "homepage": "https://github.com/glasshome/sync-layer#readme",
  "bugs": {
    "url": "https://github.com/glasshome/sync-layer/issues"
  },
  "license": "MIT",
  "author": "GlassHome Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/glasshome/sync-layer.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@glasshome/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solid": {
      "@glasshome/source": "./src/solid/index.ts",
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    },
    "./worker": {
      "@glasshome/source": "./src/worker/worker-main.ts",
      "types": "./dist/worker/worker-main.d.ts",
      "import": "./dist/worker/worker-main.js"
    },
    "./demo-ids": {
      "@glasshome/source": "./src/demo/ids.ts",
      "types": "./dist/demo/ids.d.ts",
      "import": "./dist/demo/ids.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --noEmit && bun scripts/check-widget-reachable-surface.ts",
    "dev": "tsdown --watch",
    "test": "bun test",
    "lint": "oxlint --type-aware . && oxfmt --check . && tsc --noEmit",
    "gen:demo-ids": "bun scripts/gen-demo-ids.ts",
    "check:dead": "fallow dead-code --fail-on-issues"
  },
  "dependencies": {
    "@glasshome/widget-contract": "0.3.0",
    "home-assistant-js-websocket": "^9.6.0"
  },
  "devDependencies": {
    "@glasshome/ha-types": "0.2.0",
    "@types/bun": "^1.4.0",
    "fallow": "3.17.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "solid-js": "^1.9.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@glasshome/ha-types": "0.2.0",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@glasshome/ha-types": {
      "optional": false
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
